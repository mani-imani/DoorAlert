<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="DoorAlert"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DoorAlert"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PopupActivity"
            android:exported="false"
            android:theme="@style/Theme.DoorAlert.Popup"
            android:launchMode="singleInstance"
            android:taskAffinity="ir.maniimani.dooralert.popup"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />

        <service
            android:name=".DoorService"
            android:exported="false" />

        <!-- live wallpaper: the head unit never force-stops the wallpaper app on ACC off -->
        <service
            android:name=".KeepAliveWallpaper"
            android:label="@string/wallpaper_name"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.car.action.EXIT_SLEEP" />
                <action android:name="android.car.action.CAR_BOOT_COMPLETED" />
                <action android:name="android.car.action.CAR_APP_INIT_COMPLETED" />
                <action android:name="android.car.action.ACC_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
